diff --git a/PokeIdleMulti/pokebot.js b/PokeIdleMulti/pokebot.js
new file mode 100644
index 0000000..da9252a
--- /dev/null
+++ b/PokeIdleMulti/pokebot.js
@@ -0,0 +1,61 @@
+// PokeBot: ponte entre o jogo e o motor do PokeBot (que conecta pela porta local do deck).
+// Igual ao recompra.js, acompanha o socket do proprio jogo: guarda a lista de hunts do `welcome` e a hunt atual
+// (`huntSlug`) dos `estado`, e deixa o motor mandar SO tres pedidos, os mesmos dos botoes do jogo:
+// trocar de hunt (`hunt.select`), desistir do combate (`centro.desistir`) e curar no Centro (`centro.curar`).
+(() => {
+  if (window.top !== window || window.__pokebot) return;
+
+  const PERMITIDOS = new Set(['hunt.select', 'centro.desistir', 'centro.curar']);
+  let socket = null;
+  const st = { hunts: null, huntSlug: null, noCentro: null, welcomeEm: 0 };
+
+  const Native = window.WebSocket;
+  if (typeof Native === 'function') {
+    window.WebSocket = new Proxy(Native, {
+      construct(target, args, newTarget) {
+        const ws = Reflect.construct(target, args, newTarget);
+        try {
+          if (new URL(String(args[0]), location.href).host === location.host) attach(ws);
+        } catch { }
+        return ws;
+      },
+    });
+  }
+
+  function attach(ws) {
+    socket = ws;
+    ws.addEventListener('message', (e) => {
+      if (ws !== socket || typeof e.data !== 'string') return;
+      const head = /^\{"t":"([^"]*)"/.exec(e.data);
+      if (!head || (head[1] !== 'welcome' && head[1] !== 'estado')) return;
+      // o estado chega muitas vezes: so vale abrir o que fala da hunt ou do Centro
+      if (head[1] === 'estado' && !e.data.includes('"huntSlug"') && !e.data.includes('"noCentro"')) return;
+      let m;
+      try { m = JSON.parse(e.data); } catch { return; }
+      if (m.t === 'welcome') {
+        st.hunts = Array.isArray(m.hunts)
+          ? m.hunts.map((h) => ({ slug: h.slug, nivel: h.nivel, nome: h.nome ?? h.name ?? null, especies: (h.especies ?? []).map((x) => x.pokeId) }))
+          : null;
+        st.welcomeEm = Date.now();
+      }
+      const s = m.estado;
+      if (s && typeof s === 'object') {
+        if ('huntSlug' in s) st.huntSlug = s.huntSlug ?? null;
+        if ('noCentro' in s) st.noCentro = !!s.noCentro;
+      }
+    });
+  }
+
+  Object.defineProperty(window, '__pokebot', {
+    value: Object.freeze({
+      estado: () => ({ conectado: !!socket && socket.readyState === 1, huntSlug: st.huntSlug, noCentro: st.noCentro, hunts: st.hunts ? st.hunts.length : 0, welcomeEm: st.welcomeEm }),
+      hunts: () => st.hunts,
+      enviar: (obj) => {
+        if (!obj || !PERMITIDOS.has(obj.t)) return 'pedido nao permitido';
+        if (!socket || socket.readyState !== 1) return 'jogo desconectado';
+        socket.send(JSON.stringify(obj));
+        return 'ok';
+      },
+    }),
+  });
+})();
